    <xs:simpleType name="MovimentoType">
        <xs:annotation>
            <xs:documentation>
			    Corrispondono alla tipologia di movimento turistico:
                    - MP = Movimento Presente. Da indicare quando ci sono arrivi e/o partenze
                    - NM = Nessuna Movimentazione. Da indicare quando non sono presenti ne' arrivi ne' partenze
                    - EC = Esercizio Chiuso. Da indicare quando la struttura ricettiva e' chiusa
            </xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
            <xs:enumeration value="MP" />
            <xs:enumeration value="NM" />
            <xs:enumeration value="EC" />
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="SessoType">
        <xs:annotation>
            <xs:documentation>
    			Indica il sesso di un alloggiato
            </xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
            <xs:enumeration value="M" />
            <xs:enumeration value="F" />
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="AlloggiatoType">
        <xs:annotation>
            <xs:documentation>
    			Corrispondono ai codici della tipologia alloggiato definiti nell'ambito del 
                servizio Web Alloggiati della Polizia di Stato 
                    - 16 = Ospite Singolo
                    - 17 = Capofamiglia
                    - 18 = Capogruppo
            </xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
            <xs:enumeration value="16" />
            <xs:enumeration value="17" />
            <xs:enumeration value="18" />
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="CaratteristicaViaggioType">
        <xs:annotation>
            <xs:documentation>
			    Corrispondono ai codici relativi alle modalita' di prenotazione
                    -   DIRETTAALLOGGIOINTERNET = Si intende la prenotazione diretta dell'alloggio via internet (tramite il sito web della struttura ricettiva oppure siti di prenotazione on line)
                    -   DIRETTAALLOGGIOSR = Si intende la prenotazione diretta dell'alloggio presso la struttura ricettiva (includendo i walk-in)
                    -   MEZZOTRASPORTOARRIVOINTERNET = Si intende la prenotazione via internet del mezzo di trasporto principale per arrivare in Puglia
                    -   MEZZOTRASPORTOMOVIMENTOINTERNET = Si intende la prenotazione via internet del mezzo di trasporto principale per muoversi in Puglia
                    -   AGENZIA	= Si intende la prenotazione del viaggio tramite una Agenzia di Viaggio FISICA                
                    -   TOUR = Si intende la prenotazione del viaggio tramite un Tour Operator (anche via internet)
                    -   ASSOCIAZIONE = Si intende un viaggio organizzato tramite Cral, Clubs (es. Rotary, Lions), Associazioni, Dopolavoro, Istituti Scolastici
            </xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
            <xs:enumeration value="DIRETTAALLOGGIOINTERNET" />
            <xs:enumeration value="DIRETTAALLOGGIOSR" />
            <xs:enumeration value="MEZZOTRASPORTOARRIVOINTERNET" />
            <xs:enumeration value="MEZZOTRASPORTOMOVIMENTOINTERNET" />
            <xs:enumeration value="AGENZIA" />
            <xs:enumeration value="TOUR" />
            <xs:enumeration value="ASSOCIAZIONE" />
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="DurataSoggiornoType">
        <xs:annotation>
            <xs:documentation>
                Esprime la durata in giorni dell'intero viaggio nella regione Puglia
            </xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:positiveInteger" />
    </xs:simpleType>
