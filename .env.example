# Copy to .env and adjust. All optional except SECRET_KEY in production.
APP_ENV=production
SECRET_KEY=change-me
SITE_NAME=SpotXMLMerge
CONTACT_EMAIL=
# Privacy-friendly analytics; leave blank to load no third-party script at all.
PLAUSIBLE_DOMAIN=
MAX_UPLOAD_BYTES=12582912
MAX_FILES=30
RATE_LIMIT_PER_HOUR=60
TRUST_PROXY_HEADER=1

# Gmail SMTP notifications for /api/contact submissions.
# Set SMTP_ENABLED=1 and provide a Gmail app password in SMTP_PASSWORD.
SMTP_ENABLED=0
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=1
SMTP_USE_SSL=0
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=

# Not implemented yet - see app/accounts.py
FEATURE_ACCOUNTS=0
FEATURE_BILLING=0
FEATURE_HISTORY=0
